{"title":"Clarity4Life agent operations","uid":"c4l","schemaVersion":39,"version":1,"time":{"from":"now-1h","to":"now"},"panels":[{"id":1,"title":"Requests / second","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(rate(c4l_requests_total[5m]))"}]},{"id":2,"title":"p95 latency (seconds)","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by(le) (rate(c4l_latency_seconds_bucket[5m])))"}]},{"id":3,"title":"Reported USD / request (incomplete when unknown usage > 0)","type":"timeseries","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(rate(c4l_cost_usd_total[5m])) / clamp_min(sum(rate(c4l_requests_total[5m])), 0.000001)"}]},{"id":4,"title":"Errors and timeouts / second","type":"timeseries","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(rate(c4l_requests_total{outcome=~\"error|timeout\"}[5m]))"}]},{"id":5,"title":"Unknown usage events / hour","type":"stat","gridPos":{"x":0,"y":16,"w":12,"h":6},"datasource":{"uid":"prometheus","type":"prometheus"},"targets":[{"expr":"sum(increase(c4l_unknown_usage_total[1h]))"}]}]}
